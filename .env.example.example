# Copy this file to .env.local and put your REAL values there.
# NEVER upload .env.local to GitHub.

# MongoDB
MONGODB_URI=your_mongodb_uri_here
MONGODB_DB=prep_master

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Admin panel credentials
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here
ADMIN_GMAIL=your_admin_gmail_here
ADMIN_SECRET=your_long_random_admin_secret_here

# External/authorized batch API
BATCH_API_URL=https://example.com/batches?page=1
